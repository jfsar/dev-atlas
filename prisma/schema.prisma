// Developer Roadmap Platform — Prisma 7 schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EdgeRelationship {
  PREREQUISITE
  RECOMMENDED
  OPTIONAL
  RELATED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum BlockType {
  MARKDOWN
  CODE
  CALLOUT
  CHECKLIST
  TABLE
  RESOURCE_LIST
  FAQ
}

enum ContentPointKind {
  OBJECTIVE
  ACTOR
  ENTITY
  PROCESS_STEP
  STATE
  RULE
  CONTROL
  KPI
  SOFTWARE_IMPLICATION
}

enum ResourceKind {
  ARTICLE
  VIDEO
  COURSE
  DOCS
  TOOL
  BOOK
  OTHER
}

// ---------------------------------------------------------------------------
// Better Auth (admin authentication)
// ---------------------------------------------------------------------------

model User {
  id               String     @id
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  role             UserRole   @default(USER)
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  providerId            String
  accountId             String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Roadmap graph (semantics persisted separately from layout)
// ---------------------------------------------------------------------------

model Roadmap {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  summary           String
  description       String?
  audience          String?
  prerequisiteNotes String?
  difficulty        Difficulty?
  estimatedHours    Int?
  icon              String?
  featured          Boolean           @default(false)
  order             Int               @default(0)
  status            PublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  archivedAt        DateTime?
  seoTitle          String?
  seoDescription    String?
  seoImage          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sections          RoadmapSection[]
  nodes             RoadmapNode[]
  edges             RoadmapEdge[]
  categories        RoadmapCategory[]

  @@index([status, order])
  @@index([title(ops: raw("gin_trgm_ops"))], name: "Roadmap_title_trgm_idx", type: Gin)
  @@index([summary(ops: raw("gin_trgm_ops"))], name: "Roadmap_summary_trgm_idx", type: Gin)
}

model RoadmapSection {
  id        String        @id @default(cuid())
  roadmapId String
  title     String
  color     String?
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  roadmap   Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  nodes     RoadmapNode[]

  @@index([roadmapId, order])
}

model RoadmapNode {
  id               String          @id @default(cuid())
  roadmapId        String
  sectionId        String?
  topicId          String?
  title            String
  summary          String?
  x                Float
  y                Float
  width            Float?
  height           Float?
  difficulty       Difficulty?
  estimatedMinutes Int?
  required         Boolean         @default(true)
  order            Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  section          RoadmapSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  topic            Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceEdges      RoadmapEdge[]   @relation("EdgeSource")
  targetEdges      RoadmapEdge[]   @relation("EdgeTarget")

  @@index([roadmapId])
  @@index([topicId])
}

model RoadmapEdge {
  id           String           @id @default(cuid())
  roadmapId    String
  sourceId     String
  targetId     String
  relationship EdgeRelationship @default(RECOMMENDED)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  roadmap      Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  source       RoadmapNode      @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       RoadmapNode      @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, sourceId, targetId])
  @@index([roadmapId])
  @@index([sourceId])
  @@index([targetId])
}

// ---------------------------------------------------------------------------
// Learning content
// ---------------------------------------------------------------------------

model Topic {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  summary          String
  difficulty       Difficulty?
  estimatedMinutes Int?
  status           PublicationStatus   @default(DRAFT)
  publishedAt      DateTime?
  archivedAt       DateTime?
  seoTitle         String?
  seoDescription   String?
  seoImage         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  blocks           TopicContentBlock[]
  nodes            RoadmapNode[]
  resources        TopicResource[]
  projects         Project[]           @relation("TopicProjects")
  domains          BusinessDomain[]    @relation("TopicDomains")
  relatedTopics    Topic[]             @relation("TopicRelated")
  relatedFrom      Topic[]             @relation("TopicRelated")
  categories       TopicCategory[]

  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], name: "Topic_title_trgm_idx", type: Gin)
  @@index([summary(ops: raw("gin_trgm_ops"))], name: "Topic_summary_trgm_idx", type: Gin)
}

model TopicContentBlock {
  id        String    @id @default(cuid())
  topicId   String
  type      BlockType
  order     Int       @default(0)
  title     String?
  body      String?
  language  String?
  data      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

model BusinessDomain {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  title              String
  summary            String
  definition         String?
  developerRelevance String?
  status             PublicationStatus        @default(DRAFT)
  publishedAt        DateTime?
  archivedAt         DateTime?
  seoTitle           String?
  seoDescription     String?
  seoImage           String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  points             BusinessDomainPoint[]
  topics             Topic[]                  @relation("TopicDomains")
  projects           Project[]                @relation("DomainProjects")
  resources          Resource[]               @relation("DomainResources")
  categories         BusinessDomainCategory[]

  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], name: "BusinessDomain_title_trgm_idx", type: Gin)
  @@index([summary(ops: raw("gin_trgm_ops"))], name: "BusinessDomain_summary_trgm_idx", type: Gin)
  @@index([definition(ops: raw("gin_trgm_ops"))], name: "BusinessDomain_definition_trgm_idx", type: Gin)
}

model BusinessDomainPoint {
  id        String           @id @default(cuid())
  domainId  String
  kind      ContentPointKind
  title     String
  body      String
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  domain    BusinessDomain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, order])
}

model Project {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  summary           String
  scenario          String
  difficulty        Difficulty?
  estimatedHours    Int?
  learningGoals     String?
  requirements      String?
  features          String?
  architectureNotes String?
  databaseNotes     String?
  apiNotes          String?
  testingNotes      String?
  status            PublicationStatus  @default(DRAFT)
  publishedAt       DateTime?
  archivedAt        DateTime?
  seoTitle          String?
  seoDescription    String?
  seoImage          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  milestones        ProjectMilestone[]
  resources         ProjectResource[]
  topics            Topic[]            @relation("TopicProjects")
  domains           BusinessDomain[]   @relation("DomainProjects")
  categories        ProjectCategory[]

  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], name: "Project_title_trgm_idx", type: Gin)
  @@index([summary(ops: raw("gin_trgm_ops"))], name: "Project_summary_trgm_idx", type: Gin)
  @@index([scenario(ops: raw("gin_trgm_ops"))], name: "Project_scenario_trgm_idx", type: Gin)
}

model ProjectMilestone {
  id        String   @id @default(cuid())
  projectId String
  title     String
  body      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model Resource {
  id           String             @id @default(cuid())
  url          String             @unique
  title        String
  summary      String?
  kind         ResourceKind       @default(ARTICLE)
  status       PublicationStatus  @default(DRAFT)
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  topicLinks   TopicResource[]
  projectLinks ProjectResource[]
  domains      BusinessDomain[]   @relation("DomainResources")
  categories   ResourceCategory[]

  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], name: "Resource_title_trgm_idx", type: Gin)
}

// ---------------------------------------------------------------------------
// Explicit join models (order/metadata needed)
// ---------------------------------------------------------------------------

model TopicResource {
  topicId    String
  resourceId String
  order      Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([topicId, resourceId])
  @@index([resourceId])
}

model ProjectResource {
  projectId  String
  resourceId String
  order      Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([projectId, resourceId])
  @@index([resourceId])
}

// ---------------------------------------------------------------------------
// Taxonomy (categories)
// ---------------------------------------------------------------------------

model Category {
  id          String                   @id @default(cuid())
  slug        String                   @unique
  name        String
  description String?
  order       Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  roadmaps    RoadmapCategory[]
  topics      TopicCategory[]
  projects    ProjectCategory[]
  resources   ResourceCategory[]
  domains     BusinessDomainCategory[]
}

model RoadmapCategory {
  roadmapId  String
  categoryId String
  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([roadmapId, categoryId])
  @@index([categoryId])
}

model TopicCategory {
  topicId    String
  categoryId String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([topicId, categoryId])
  @@index([categoryId])
}

model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@index([categoryId])
}

model ResourceCategory {
  resourceId String
  categoryId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([resourceId, categoryId])
  @@index([categoryId])
}

model BusinessDomainCategory {
  domainId   String
  categoryId String
  domain     BusinessDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([domainId, categoryId])
  @@index([categoryId])
}
