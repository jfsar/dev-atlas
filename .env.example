# Copy to .env and adjust as needed. Never commit .env.
# `npm run docker:app:up` overrides DATABASE_URL/BETTER_AUTH_URL for the
# in-container app, so the values below stay correct for host development.

# PostgreSQL connection string (matches compose.yaml).
DATABASE_URL="postgresql://roadmap:roadmap@localhost:5432/roadmap?schema=public"

# Optional Neon Postgres overrides. When set, the app uses the pooled URL for
# fetch/insert traffic, while seeding and migrations use the unpooled (direct)
# URL. Leave unset to keep everything on DATABASE_URL above.
# NEON_DB_POOLED_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# NEON_DB_UNPOOLED_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth (generate a long random secret for real use).
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:5173"

# Public canonical origin used for SEO tags and structured data (optional).
VITE_SITE_URL="http://localhost:5173"

# Admin bootstrap (used by `npm run db:seed`; no public registration exists).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
# ADMIN_NAME="Admin"
